{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": ".next",
  "git": {
    "deploymentEnabled": {
      "qa/full-ecosystem-e2e-20260807": false
    }
  },
  "crons": [
    { "path": "/api/map/rebuild", "schedule": "0 5 * * *" },
    { "path": "/api/cron/company-lifecycle", "schedule": "15 5 * * *" },
    { "path": "/api/cron/weekly-payouts", "schedule": "0 14 * * 5" }
  ]
}
