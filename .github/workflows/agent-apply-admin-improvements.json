{
  "name": "Apply focused Admin improvements",
  "on": {
    "push": {
      "branches": [
        "feature/25-30-homes-simulator-v1"
      ],
      "paths": [
        ".github/workflows/agent-apply-admin-improvements.json"
      ]
    }
  },
  "permissions": {
    "contents": "write"
  },
  "jobs": {
    "apply": {
      "runs-on": "ubuntu-latest",
      "steps": [
        {
          "uses": "actions/checkout@v4",
          "with": {
            "ref": "feature/25-30-homes-simulator-v1",
            "token": "${{ secrets.GITHUB_TOKEN }}"
          }
        },
        {
          "uses": "actions/setup-node@v4",
          "with": {
            "node-version": "22"
          }
        },
        {
          "name": "Apply source changes",
          "shell": "bash",
          "run": "echo ' oYXModGRbY29sc3Bhbl0pKXt0cmFuc2l0aW9uOmJhY2tncm91bmQgLjE0cyBlYXNlfQouY3VzdG9tZXItZGlyZWN0b3J5LWNhcmQgdGJvZHkgdHI6bm90KDp ' | base64 -d > /tmp/apply_admin.py
python /tmp/apply_admin.py"
        },
        {
          "name": "Verify real diff",
          "shell": "bash",
          "run": "git diff --check
git diff --quiet && { echo 'No source changes were applied'; exit 1; } || true
grep -q 'getPropertyPhotoHistory(next.property.id).catch' \"app/admin/customers/[id]/page.tsx\"
! grep -q '\\[\"Dashboard\", \"/admin/command\"\\]' components/admin/AdminShell.tsx
grep -q 'V53.2 focused Admin layout' app/globals.css"
        },
        {
          "name": "Install dependencies",
          "shell": "bash",
          "run": "corepack enable
pnpm install --frozen-lockfile"
        },
        {
          "name": "Validate",
          "shell": "bash",
          "run": "pnpm check
pnpm build"
        },
        {
          "name": "Commit verified source",
          "shell": "bash",
          "run": "rm -f .github/workflows/agent-apply-admin-improvements.json
git config user.name 'github-actions[bot]'
git config user.email '41898282+github-actions[bot]@users.noreply.github.com'
git add -A
git commit -m 'Polish Admin layouts and speed up property profiles'
git push origin HEAD:feature/25-30-homes-simulator-v1"
        }
      ]
    }
  }
}