NEXT_PUBLIC_SUPABASE_URL=https://kirgirjmasvzkykxtjde.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_faifeK_3kl2CO7MAyvta4A_JE9d4DRs
NEXT_PUBLIC_DEMO_MODE=false

# Mobile browser portal policy. Values: off | all.
# Default is all: Android/iOS browsers are app-only; native wrappers bypass the gate.
# Legacy value "android" is treated as "all" by middleware so an old env cannot reopen iOS.
MOBILE_WEB_GATE_MODE=all
# NEXT_PUBLIC_ANDROID_APP_URL=https://play.google.com/store/apps/details?id=your.package
# NEXT_PUBLIC_IOS_APP_URL=https://apps.apple.com/app/your-app/id0000000000

# Never expose service role, Stripe secret, webhook, or cron keys in browser/client code.
# Required by server-only admin, map rebuild, Stripe, and scheduled payout routes.
# SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
# CRON_SECRET=long-random-server-only-secret
# STRIPE_SECRET_KEY=sk_test_replace_me
# STRIPE_WEBHOOK_SECRET=whsec_your_account_destination
# STRIPE_CONNECT_WEBHOOK_SECRET=whsec_connected_accounts_destination
# STRIPE_PLATFORM_FEE_PERCENT=0
# Production canonical URL. Local/preview environments may override this explicitly.
# NEXT_PUBLIC_SITE_URL=https://www.4everseasons.com
